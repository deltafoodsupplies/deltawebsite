# Copy to .env for local development (never commit .env)

# --- Required ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/delta?retryWrites=true&w=majority

# --- Optional ---
PORT=8080
CORS_ORIGINS=https://deltafoodsupplies.com,https://www.deltafoodsupplies.com
# Local testing without a database:
# SKIP_DB=1

# --- Email notifications (submissions are stored even if unset) ---
# Google Workspace: smtp.gmail.com + an App Password on sales@deltafoodsupplies.com
# SendGrid: smtp.sendgrid.net, user "apikey", pass = your API key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=website@deltafoodsupplies.com
MAIL_TO=sales@deltafoodsupplies.com
